# Copy this file to .env and fill in what you need. Restart the app after changes.

# Where the Excel workbook, bills and photos are kept.
# Default local mode: ./data
# Cloud mode: set STORAGE=google and point to one shared Drive folder.
DATA_DIR=./data
STORAGE=local

# Postgres mode: set STORAGE=postgres and give the connection string.
# Local dev: docker run -d --name buslog-pg -e POSTGRES_PASSWORD=dev -e POSTGRES_DB=buslog -p 5432:5432 postgres:16
# DATABASE_URL=postgres://postgres:dev@localhost:5432/buslog
# New schools can sign themselves up at /signup.html. Require a code so only schools you invite can join,
# or close signup with ALLOW_SIGNUP=false.
# SIGNUP_CODE=choose-a-code-to-share
# ALLOW_SIGNUP=true
# New signups wait for payment and approval (approve with scripts/admin.js approve <org-id>).
# What they see while waiting: an https payment link (e.g. a Razorpay Payment Link), a note, and a support email.
# PAYMENT_URL=https://rzp.io/l/your-link
# PAYMENT_NOTE=Fee: Rs 5,000 per year. We approve within one working day of payment.
# SUPPORT_EMAIL=support@yourdomain.com
# Users and organisations are created with: node --env-file=.env scripts/admin.js create-org "Name"
# Copy an existing Excel workbook into a school: node --env-file=.env scripts/import-xlsx.js school-001 ./data
# Only if you used an early Postgres version: the school that owns files saved before school folders existed.
# LEGACY_SCHOOL_ID=school-001

# Port for the app in your browser: http://localhost:3000
PORT=3000

# School admin login for the single-school deployment.
ADMIN_EMAIL=admin@school.local
ADMIN_PASSWORD=change-this-password

# Google OAuth login for the school Google account.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
GOOGLE_DRIVE_FOLDER_NAME=Transportation

# Google Drive deployment settings for the shared school folder.
# This should point to the shared folder ID in Google Drive, not the workbook file.
GOOGLE_DRIVE_FOLDER_ID=
# You can use either a JSON string or a path to a service-account JSON key.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=

# Name recorded in the change log for entries made on this computer.
OFFICE_USER=Transport office

# Optional: turns on "Read bill with AI". Get a key at console.anthropic.com.
# Keep this file private; never put the key in the Excel file.
ANTHROPIC_API_KEY=
