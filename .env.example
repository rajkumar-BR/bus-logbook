# Copy this file to .env and fill in what you need. Restart the app after changes.

# ---- Database (required) ----
# Local database: docker run -d --name buslog-pg -e POSTGRES_PASSWORD=dev -e POSTGRES_DB=buslog -p 5432:5432 postgres:16
DATABASE_URL=postgres://postgres:dev@localhost:5432/buslog
# Hosted databases (Supabase, Neon, Render) need SSL:
# DATABASE_SSL=require

# ---- Server ----
PORT=3000
# On a host such as Render the app must listen on all addresses (the default is this computer only):
# HOST=0.0.0.0

# ---- Bills and photos ----
# Default: folders under DATA_DIR. For a hosted deployment use an S3-compatible private bucket
# (Supabase Storage, Cloudflare R2, AWS S3):
DATA_DIR=./data
# FILES=s3
# S3_BUCKET=bus-logbook-files
# S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
# S3_REGION=ap-south-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ---- Signup and approval ----
# Organisations can sign themselves up at /signup.html, then wait for payment and approval
# (approve with: node --env-file=.env scripts/admin.js approve <org-id>).
# Require a code so only organisations you invite can sign up, or close signup with ALLOW_SIGNUP=false.
# SIGNUP_CODE=choose-a-code-to-share
# ALLOW_SIGNUP=true
# What a waiting organisation sees: an https payment link (e.g. a Razorpay Payment Link), a note, a support email.
# PAYMENT_URL=https://rzp.io/l/your-link
# PAYMENT_NOTE=Fee: Rs 5,000 per year. We approve within one working day of payment.
# SUPPORT_EMAIL=support@yourdomain.com

# ---- AI bill reading (optional) ----
# Get a key at console.anthropic.com. Keep this file private.
ANTHROPIC_API_KEY=
